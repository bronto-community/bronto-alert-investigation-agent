# Every environment variable the investigator reads, grouped by what needs it.
# Nothing loads this file for you: copy it to .env (gitignored), fill in what you
# use, and `set -a; source .env; set +a` before running.

# --- Bronto (required) --------------------------------------------------------
BRONTO_API_KEY=
BRONTO_REGION=            # eu or us
# BRONTO_MCP_BASE_URL=    # only for a non-standard MCP host; /mcp is appended

# --- model provider (set the one --provider names) ----------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AWS_REGION=             # bedrock: region, plus AWS_PROFILE or a key pair
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=      # only for temporary (ASIA…) keys

# --- Slack (the bot, or the webhook's --report slack) -------------------------
# SLACK_BOT_TOKEN=        # xoxb-…
# SLACK_APP_TOKEN=        # xapp-…, the Socket Mode bot only

# --- webhook receiver ---------------------------------------------------------
# BRONTO_WEBHOOK_SECRET=

# --- tracing (optional) -------------------------------------------------------
# A local collector, or Bronto directly (https://ingestion.<region>.bronto.io).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=   # for Bronto: x-bronto-api-key=<your Bronto API key>
