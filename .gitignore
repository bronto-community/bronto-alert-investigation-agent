# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
.cache
.hypothesis/
.pytest_cache/

# Linters / type checkers
.ruff_cache/
.mypy_cache/

# pyenv / uv — .python-version IS committed here (see the negation below) so that
# every checkout and CI run develops on the same interpreter.
.python-version
!/.python-version

# Environments
.env
.venv
env/
venv/
ENV/

# Visual Studio Code — settings and extension recommendations are checked in
# so every contributor and CI see the same diagnostics; everything else is local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Git
*.orig

# Agent instructions are kept local to each maintainer's checkout.
AGENTS.md
CLAUDE.md
.claude/

# Your own deploy configs, copied from deploy/*.example.toml
/fly.toml
/fly.webhook.toml

# Generated graph visualisations (visualize_graph.py)
/graph.dot
/graph.svg
